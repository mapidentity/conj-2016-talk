diff --git a/test/clojure/test_clojure/reader.cljc b/test/clojure/test_clojure/reader.cljc
index a0e1f1f1..a33f7c36 100644
--- a/test/clojure/test_clojure/reader.cljc
+++ b/test/clojure/test_clojure/reader.cljc
@@ -800,3 +800,31 @@
   (eval (-> "^{:line 42 :column 99} (defn explicit-line-numbering [])" str->lnpr read))
   (is (= {:line 42 :column 99}
          (-> 'explicit-line-numbering resolve meta (select-keys [:line :column])))))
+
+(deftest t-read-positions
+  (let [s "[1 [2]\n {:a #{3}} #:x{:y 4} [] {} #{}]"
+        read-with #(binding [*read-positions* %] (read (str->lnpr s)))
+        pos #(select-keys (meta %) [:line :column])
+        v (read-with true)]
+    (is (= (read-with false) v))
+    (is (nil? (meta (read-with false))))
+    (is (= {:line 1 :column 1} (pos v)))
+    (is (= {:line 1 :column 4} (pos (v 1))))
+    (is (= {:line 2 :column 2} (pos (v 2))))
+    (is (= {:line 2 :column 6} (pos (get-in v [2 :a]))))
+    (is (= {:line 2 :column 12} (pos (v 3))))
+    (is (every? #(instance? Integer %) (vals (pos v))))
+    (is (every? nil? (map meta (subvec v 4)))))
+  (is (nil? (meta (binding [*read-positions* true] (read-string "[1]")))))
+  (let [read-sq #(binding [*read-positions* %] (read (str->lnpr "`[a {:b c}]")))]
+    (is (= (read-sq false) (read-sq true))))
+  (testing ":file from *file*, when it names a file"
+    (let [read-in #(binding [*read-positions* true *file* %] (read (str->lnpr "[1 `[a]]")))]
+      (is (= {:line 1 :column 1 :file "a/b.clj"} (meta (read-in "a/b.clj"))))
+      (is (= {:line 1 :column 1} (meta (read-in "NO_SOURCE_PATH"))))
+      (is (= (binding [*read-positions* false] (read (str->lnpr "`[a]")))
+             ((read-in "a/b.clj") 1)))))
+  (testing "the compiler keeps the position on the value"
+    (is (= {:line 1 :column 1}
+           (-> (binding [*read-positions* true] (read (str->lnpr "[1 (inc 1)]")))
+               eval meta (select-keys [:line :column]))))))
