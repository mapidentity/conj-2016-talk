+// When *read-positions* is true, vector, map and set literals get the :line
+// and :column that ListReader always gives lists, and the :file being loaded.
+// Returns the position of a literal whose opening delimiter (1 char, or 2 for
+// #{ and #:) was just read.
+static IPersistentMap startPosition(PushbackReader r, int delimLength){
+	if(!(r instanceof LineNumberingPushbackReader) || !RT.booleanCast(RT.READ_POSITIONS.deref()))
+		return null;
+	LineNumberingPushbackReader lr = (LineNumberingPushbackReader) r;
+	IPersistentMap pos = RT.map(RT.LINE_KEY, lr.getLineNumber(), RT.COLUMN_KEY, lr.getColumnNumber()-delimLength);
+	Object file = Compiler.SOURCE_PATH.deref();
+	if(file instanceof String && !file.equals("NO_SOURCE_PATH"))
+		pos = pos.assoc(RT.FILE_KEY, file);
+	return pos;
+}
+
+// Like ListReader, empty literals get no position
+static Object withPosition(IObj o, IPersistentMap pos){
+	if(pos == null || RT.count(o) == 0)
+		return o;
+	return o.withMeta(pos);
+}
