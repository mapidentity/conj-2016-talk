+// PROTOTYPE (constfix): an otherwise-constant collection literal whose metadata is itself all-constant
+// (e.g. reader positions) stays a hoisted constant; emitValue already emits the metadata onto constants.
+static boolean constantMeta(IPersistentMap m){
+	// position keys only, so a user's ^:foo [1 2] compiles exactly as before
+	for(ISeq s = RT.seq(m); s != null; s = s.next())
+		{
+		Object k = ((IMapEntry) s.first()).key();
+		if(!(k == RT.LINE_KEY || k == RT.COLUMN_KEY || k == RT.FILE_KEY))
+			return false;
+		}
+	return true;
+}
+// OPTION C sketch: under :literal-positions the compiler, which knows the source
+// path, adds :file to a positioned literal's metadata (the reader stays file-agnostic)
+static IPersistentMap literalMeta(IPersistentMap m){
+	if(m == null || !RT.booleanCast(getCompilerOption(literalPositionsKey))
+	   || !m.containsKey(RT.LINE_KEY) || m.containsKey(RT.FILE_KEY))
+		return m;
+	Object f = SOURCE_PATH.deref();
+	if(!(f instanceof String) || f.equals("NO_SOURCE_PATH") || f.equals("NO_SOURCE_FILE"))
+		return m;
+	return m.assoc(RT.FILE_KEY, f);
+}
+static Object withFormMeta(Object v, Object form){
+	IPersistentMap m = (form instanceof IObj) ? literalMeta(((IObj) form).meta()) : null;
+	return m == null ? v : ((IObj) v).withMeta(m);
+}
