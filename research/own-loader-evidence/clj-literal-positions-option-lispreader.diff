+// OPTION C sketch: with {:positions true} in the read opts, vector, map and set
+// literals get the :line/:column ListReader always gives lists. Opt-in per read
+// call; Compiler.load asks for it when *compiler-options* has :literal-positions.
+static IPersistentMap startPosition(PushbackReader r, int delimLength, Object opts){
+	if(!(r instanceof LineNumberingPushbackReader) || !(opts instanceof IPersistentMap)
+	   || !RT.booleanCast(((IPersistentMap) opts).valAt(OPT_POSITIONS)))
+		return null;
+	LineNumberingPushbackReader lr = (LineNumberingPushbackReader) r;
+	return RT.map(RT.LINE_KEY, lr.getLineNumber(), RT.COLUMN_KEY, lr.getColumnNumber()-delimLength);
+}
+
+static Object withPosition(IObj o, IPersistentMap pos){
+	if(pos == null || RT.count(o) == 0)
+		return o;
+	return o.withMeta(pos);
+}
